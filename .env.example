# 在本目錄複製為 .env，再執行：
# docker compose -f compose.yaml -f compose.standalone.yaml up -d --build

# 單機宿主的模型目錄，唯讀掛載至容器 /data/models。
SKILL_MODELS_DIR=./models
PATH_BASE=/

# 以下模型／清單路徑均為容器內路徑。
# IMAGE_MODEL 須為含 model_index.json 的完整 Diffusers 文字生圖模型目錄。
IMAGE_MODEL=/data/models/base-models/Qwen-Image-2.1
LLM_MODEL=/data/models/llm/Qwen2.5-1.5B-Instruct
EMBED_MODEL=/data/models/embedding/paraphrase-multilingual-MiniLM-L12-v2

# 1：使用已下載模型，不從 Hugging Face 下載；0：允許 LLM／embedding 線上載入。
# IMAGE_MODEL 仍只從本機載入。
HF_HUB_OFFLINE=1

# 預設使用映像內附的 LoRA 清單。
LORA_LIBRARY=/app/lora_library.json
# 要不停機更新清單，先備妥宿主 models/loras/library.json，再改用下列設定：
# LORA_LIBRARY=/data/models/loras/library.json
# 設定生效後以原子 rename 更新 JSON；已引用的舊版權重保留至工作結束。

# auto：以 IMAGE_MODEL 的目錄名稱匹配清單的 base_model。
# 不同微調版本共用 LoRA 家族時，可明確填寫相容標記，例如 Qwen-Image-2.1。
LORA_BASE_MODEL=auto
MAX_LORAS=2
SIMILARITY_THRESHOLD=0.45
DEFAULT_LORA_WEIGHT=0.3

# 量化：4bit、8bit、none；套用 LLM、影像 text encoder 與 transformer／UNet。
QUANTIZATION=4bit
# offload：none、model、sequential；sequential 僅能搭配 QUANTIZATION=none。
# none 讓模型常駐 GPU；model／sequential 會在需要時搬移模型並需要額外 CPU RAM。
OFFLOAD_MODE=none
# auto：可見 GPU 顯存的 90%；也可填 GiB 數值，例如 12。
# 只限制 PyTorch allocator，CUDA context／外部配置仍會額外占用。
GPU_MEMORY_GIB=auto
# 1：分塊 VAE 解碼以降低大圖峰值；0：停用。
VAE_TILING=1

# 圖片參數。
WIDTH=1024
HEIGHT=1024
STEPS=40
SEED=42
# 僅適用具有 true_cfg_scale 參數的 pipeline。
TRUE_CFG_SCALE=1.0
